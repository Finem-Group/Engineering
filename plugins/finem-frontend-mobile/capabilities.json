{
  "schemaVersion": 3,
  "plugin": "finem-frontend-mobile",
  "kind": "area",
  "version": "0.7.0",
  "dependencies": [
    "finem-core"
  ],
  "area": "frontend-mobile",
  "title": "Frontend & Mobile",
  "purpose": "Implement the interface in the project's actual web or mobile framework, connecting state, navigation and API boundaries.",
