        {
          "skill": "vercel:react-best-practices",
          "source": "vercel",
          "plugin": "finem-core",
          "path": "upstream/vercel/skills/react-best-practices/SKILL.md"
        },
        {
          "skill": "vercel:composition-patterns",
          "source": "vercel",
          "plugin": "finem-core",
          "path": "upstream/vercel/skills/composition-patterns/SKILL.md"
        }
      ]
    }
  ],
  "sources": []
}
