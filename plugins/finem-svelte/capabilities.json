{
  "schemaVersion": 1,
  "plugin": "finem-svelte",
  "kind": "pack",
  "version": "0.5.0",
  "dependencies": [
    "finem-core"
  ],
  "extension": "svelte",
  "conflicts": [
    "finem-react-ui",
    "finem-expo"
  ],
  "exclusiveGroup": "web-framework",
  "capabilities": [
    {
      "id": "frontend",
      "title": "Frontend",
      "phase": "build",
      "requires": [
        "api-contracts"
      ],
      "connectors": [
        "context7",
        "paper"
      ],
      "coverage": "composed",
      "replace": true,
      "entrypoints": [
        {
          "skill": "addy:frontend-ui-engineering",
          "source": "addy",
          "path": "upstream/addy/skills/frontend-ui-engineering/SKILL.md"
        },
        {
          "skill": "svelte:svelte-code-writer",
          "source": "svelte",
          "path": "upstream/svelte/tools/skills/svelte-code-writer/SKILL.md"
        },
        {
          "skill": "svelte:svelte-core-bestpractices",
          "source": "svelte",
          "path": "upstream/svelte/tools/skills/svelte-core-bestpractices/SKILL.md"
        }
      ]
    },
    {
      "id": "performance",
      "title": "Performance",
      "phase": "verify",
      "requires": [],
      "connectors": [
        "sentry"
      ],
      "coverage": "composed",
      "replace": true,
      "entrypoints": [
        {
          "skill": "addy:performance-optimization",
          "source": "addy",
          "path": "upstream/addy/skills/performance-optimization/SKILL.md"
        }
      ]
    }
  ],
  "sources": [
    {
      "id": "addy",
      "repository": "https://github.com/addyosmani/agent-skills",
      "revision": "6ca0cd7db39b41b1c37e26d335c507ee92382c6d",
      "license": "MIT",
      "verifiedAt": "2026-09-11",
      "caveat": "Original upstream skill directories and supporting files. Invoke selected specialists within the single L11 workflow; do not activate source bootstrap routers or global hooks."
    },
    {
      "id": "svelte",
      "repository": "https://github.com/sveltejs/ai-tools",
      "revision": "e7d93fcc168b5f4b3fec57c22f49a36d57e8ee1a",
      "license": "MIT",
      "verifiedAt": "2026-09-11",
      "caveat": "Official Svelte instructions plus framework-aware analysis and documentation CLI. Svelte 5/SvelteKit project, svelte-check and project build. Optional project-private @sveltejs/mcp 0.1.26 CLI for required autofixer. npm 0.1.26 depends on tmcp 1.20.0-next.1 and eslint ^9.36.0. Pin complete toolchain; released top-level package has prerelease transitive dependency. Use canonical tools/skills originals; omit Claude/Cursor/OpenCode copies and global routers. Prefer file argument to autofixer; original POSIX dollar-escaping examples must not be copied literally into PowerShell. Optional editor subagent advice does not require creating one."
    }
  ]
}
